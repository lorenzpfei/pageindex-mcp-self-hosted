# LLM key used during ingest (tree building + vision OCR). The default model
# is gemini/gemini-4-hydrogen, so a Gemini key is required unless you switch
# PAGEINDEX_MODEL / PAGEINDEX_OCR_MODEL to another LiteLLM provider.
GEMINI_API_KEY=
#OPENAI_API_KEY=

# Bearer token required by clients connecting to the MCP server.
# Generate e.g. with: openssl rand -hex 32
PAGEINDEX_MCP_API_KEY=

# Optional: LLM that builds the tree in standard mode (any LiteLLM model id,
# e.g. gpt-6-luna or anthropic/claude-haiku-5-5). Default gemini/gemini-4-hydrogen.
#PAGEINDEX_MODEL=

# Optional: LLM that writes node summaries and the document description
# (the only model flash mode calls). Default: PAGEINDEX_MODEL.
#PAGEINDEX_SUMMARY_MODEL=

# Optional: "auto" (default) builds the tree from the PDF's layout and
# bookmarks (flash) and falls back to the LLM-built tree (standard) for
# scanned PDFs or when flash finds no usable structure; "standard" always
# uses the LLM-built tree.
#PAGEINDEX_INDEX_MODE=auto

# Optional: vision model that transcribes pages with little/no extractable
# text (scans, image-heavy slides). Set to "off" to disable OCR.
#PAGEINDEX_OCR_MODEL=gemini/gemini-4-hydrogen

# Optional: vision model that finds figures (diagrams, plots, sketches,
# photos) on every PDF page after ingest; they are cropped and served as
# images. One call per page. Set to "off" to disable.
#PAGEINDEX_FIGURE_MODEL=gemini/gemini-4-hydrogen

# Optional: parallel PDF ingests (default 2). Each one holds the PDF + tree
# in memory and already parallelizes its LLM calls internally, so high
# values mostly burn RAM and OpenAI rate limits.
#PAGEINDEX_INGEST_WORKERS=2

# Optional: cap on simultaneous LLM calls (default 8): shared across OCR and
# figure detection, and the summary concurrency of each flash ingest.
#PAGEINDEX_MAX_CONCURRENT_LLM=8
